{
  "name": "@stealthbridge/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "StealthBridge read-only client and contracts spec for early testnet integration",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.0"
  }
}
